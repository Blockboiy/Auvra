{
  "name": "auvra",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,blue \"corepack pnpm --filter @auvra/api dev\" \"corepack pnpm --filter @auvra/web dev\"",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
