# Copy to .env in the repository root. Never commit a real API key.
ORBIO_API_KEY=
ORBIO_BASE_URL=https://api.orbio.so/api/v1
# Set this to an exact supported model ID from Orbio's live model catalogue.
ORBIO_MODEL=deepseek/deepseek-v4.1-flash
# Ordered routing pool: primary first, then verified fallback models.
# MiMo is omitted because the current probe returned no serving provider.
ORBIO_MODELS=deepseek/deepseek-v4.1-flash,google/gemini-3.8-flash,openai/gpt-6-astra
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
AUVRA_MAX_STEPS=6
AUVRA_MISSION_TIMEOUT_MS=360000
AUVRA_PREFLIGHT_COST_USD=0.002
AUVRA_MAX_OUTPUT_TOKENS=700
AUVRA_PROVIDER_TIMEOUT_MS=90000
# Avoid automatic retries for uncertain upstream charging until validated.
AUVRA_PROVIDER_RETRIES=0

# Optional external search index for real-world research missions (server-only).
# Orbio remains the inference provider. Get this key from Brave Search API.
BRAVE_SEARCH_API_KEY=
